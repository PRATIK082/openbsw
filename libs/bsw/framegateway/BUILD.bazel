load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "framegateway",
    srcs = [
        "src/framegateway/DiagLink.cpp",
        "src/framegateway/DoIpHandler.cpp",
        "src/framegateway/FrameGateway.cpp",
        "src/framegateway/GatewayConfigParser.cpp",
        "src/framegateway/GatewayPolicy.cpp",
        "src/framegateway/GatewayStack.cpp",
        "src/framegateway/PduAssembler.cpp",
        "src/framegateway/TpGateway.cpp",
        "src/framegateway/XcpServer.cpp",
        "src/framegateway/XcpSymbolTable.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/async",
        "//libs/bsw/lifecycle",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "framegateway_test",
    testonly = True,
    srcs = [
        "test/src/framegateway/DiagLinkTest.cpp",
        "test/src/framegateway/DoIpHandlerTest.cpp",
        "test/src/framegateway/FrameGatewayTest.cpp",
        "test/src/framegateway/GatewayConfigParserTest.cpp",
        "test/src/framegateway/GatewayPolicyTest.cpp",
        "test/src/framegateway/GatewayStackTest.cpp",
        "test/src/framegateway/PduAssemblerTest.cpp",
        "test/src/framegateway/TpGatewayTest.cpp",
        "test/src/framegateway/XcpServerTest.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":framegateway",
        "//libs/bsw/async:async_mock",
        "//libs/bsw/async:async_mock_impl",
        "//libs/3rdparty/googletest:gmock_main",
    ],
)
