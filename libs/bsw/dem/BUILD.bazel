load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "dem",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "dem_test",
    testonly = True,
    srcs = ["test/src/dem/DemTest.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":dem",
        "//libs/3rdparty/googletest:gmock_main",
    ],
)
