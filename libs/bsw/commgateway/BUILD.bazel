load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "commgateway",
    srcs = [
        "src/commgateway/CommStack.cpp",
        "src/commgateway/CommStateManager.cpp",
        "src/commgateway/CommStatistics.cpp",
        "src/commgateway/EthChannel.cpp",
        "src/commgateway/EthIpdu.cpp",
        "src/commgateway/GatewayConfigParser.cpp",
        "src/commgateway/InterruptRouter.cpp",
        "src/commgateway/LinChannel.cpp",
        "src/commgateway/LinScheduler.cpp",
        "src/commgateway/SignalGateway.cpp",
        "src/commgateway/TimeoutMonitor.cpp",
        "src/commgateway/TxConfirmationMgr.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/async",
        "//libs/bsw/canstack",
        "//libs/bsw/lifecycle",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "commgateway_test",
    testonly = True,
    srcs = [
        "test/src/commgateway/CommStackTest.cpp",
        "test/src/commgateway/CommStateManagerTest.cpp",
        "test/src/commgateway/EthIpduTest.cpp",
        "test/src/commgateway/GatewayConfigParserTest.cpp",
        "test/src/commgateway/InterruptRouterTest.cpp",
        "test/src/commgateway/LinChannelTest.cpp",
        "test/src/commgateway/SignalGatewayTest.cpp",
        "test/src/commgateway/TimeoutMonitorTest.cpp",
        "test/src/commgateway/TxConfirmationMgrTest.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":commgateway",
        "//libs/bsw/async:async_mock",
        "//libs/bsw/async:async_mock_impl",
        "//libs/3rdparty/googletest:gmock_main",
    ],
)
